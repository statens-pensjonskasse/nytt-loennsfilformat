{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spk.no/schemas/spk-medlemsdata/json/kvittering.json",
  "title": "Kvittering for innsending av tidslinjer",
  "description": "SPKs svar på en innsending. MOTTATT og BEHANDLES er foreløpige, og avsender henter kvitteringen på nytt etter Retry-After. FERDIG og AVVIST er endelige. Personer identifiseres med plassen sin i innsendingen.",
  "$comment": "Status: utkast",
  "type": "object",
  "properties": {
    "versjon": {
      "$ref": "felles.json#/$defs/versjon"
    },
    "innsendingsId": {
      "$ref": "felles.json#/$defs/referanse",
      "title": "Innsendings-ID",
      "description": "innsendingsId fra innsendingen kvitteringen gjelder. Utelates når innsendingen er avvist ved mottak før innsendingsId er lest."
    },
    "mottaksreferanse": {
      "title": "Mottaksreferanse",
      "description": "SPKs referanse til innsendingen, laget ved mottak. Utelates når innsendingen er avvist ved mottak.",
      "type": "string",
      "format": "uuid"
    },
    "mottakstidspunkt": {
      "$ref": "felles.json#/$defs/tidspunkt",
      "title": "Mottakstidspunkt"
    },
    "status": {
      "title": "Status",
      "description": "MOTTATT betyr at innsendingen ikke er behandlet ennå, og BEHANDLES at den er under behandling. FERDIG betyr at den er behandlet og at resultatet står i personer. AVVIST betyr at hele innsendingen er avvist, og årsaken står i feil.",
      "type": "string",
      "enum": [
        "MOTTATT",
        "BEHANDLES",
        "FERDIG",
        "AVVIST"
      ]
    },
    "feil": {
      "title": "Feil",
      "description": "Feil som gjelder hele innsendingen",
      "type": "array",
      "items": {
        "$ref": "#/$defs/feil"
      }
    },
    "personer": {
      "title": "Resultat per person",
      "description": "Oppgis når status er FERDIG",
      "type": "array",
      "items": {
        "$ref": "#/$defs/personresultat"
      }
    }
  },
  "required": [
    "versjon",
    "mottakstidspunkt",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "AVVIST"
            }
          }
        }
      },
      "then": {
        "required": [
          "innsendingsId",
          "mottaksreferanse"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FERDIG"
          }
        }
      },
      "then": {
        "required": [
          "personer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "AVVIST"
          }
        }
      },
      "then": {
        "required": [
          "feil"
        ],
        "properties": {
          "feil": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "stillingskobling": {
      "title": "Stillingskobling",
      "type": "object",
      "properties": {
        "stillingsid": {
          "title": "Stillingsid",
          "description": "Ny stillingsid fra avsender",
          "type": "string",
          "minLength": 1
        },
        "spkStillingsid": {
          "title": "SPKs stillingsid",
          "description": "Stillingsid SPK har for stillingen fra før.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "stillingsid",
        "spkStillingsid"
      ],
      "additionalProperties": false
    },
    "personresultat": {
      "title": "Personresultat",
      "type": "object",
      "properties": {
        "indeks": {
          "title": "Indeks",
          "description": "Personens plass i personer i innsendingen, regnet fra 0",
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "title": "Status",
          "description": "Status for resultatet. MANUELL betyr at SPK har opprettet en sak til manuell behandling.",
          "type": "string",
          "enum": [
            "OK",
            "AVVIST",
            "MANUELL"
          ]
        },
        "koblinger": {
          "title": "Koblinger",
          "description": "Bare for OK. Viser hver ny stillingsid som SPK har koblet til en stilling SPK har fra før. Er koblingen feil, sender avsender en stillingsidendring med spkStillingsid som tidligereStillingsid.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/stillingskobling"
          },
          "minItems": 1
        },
        "feil": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feil"
          }
        }
      },
      "required": [
        "indeks",
        "status"
      ],
      "if": {
        "properties": {
          "status": {
            "enum": [
              "AVVIST",
              "MANUELL"
            ]
          }
        }
      },
      "then": {
        "required": [
          "feil"
        ],
        "properties": {
          "feil": {
            "minItems": 1
          }
        }
      },
      "additionalProperties": false
    },
    "feil": {
      "title": "Feil",
      "type": "object",
      "properties": {
        "kode": {
          "title": "Feilkode",
          "description": "Stabil kode avsender kan programmere mot. Koden er enten et kontrollbrudd, eller SKJEMA_ fulgt av nøkkelordet i JSON Schema når skjemaet er brutt. Kjente kontrollbrudd står i examples. Nye koder kan komme i en minorversjon, og avsender må tåle koder den ikke kjenner.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,49}$",
          "examples": [
            "JSON_UGYLDIG",
            "ORGANISASJONSNUMMER_UGYLDIG",
            "FOEDSELSNUMMER_UGYLDIG",
            "REGISTRERT_FRA_ETTER_TIL",
            "PERIODE_FOER_GJELDER_FRA",
            "PERIODE_TIL_FOER_FRA",
            "PERIODE_LOEPENDE_IKKE_SIST",
            "PERIODE_OVERLAPP",
            "SLUTTAARSAK_UTEN_SLUTT",
            "STILLINGSID_DUPLIKAT",
            "STILLINGSID_GJENBRUKT",
            "FOEDSELSNUMMER_DUPLIKAT",
            "TIMER_DUPLIKAT",
            "TIMER_MAANED_FREM_I_TID",
            "STILLINGSIDENDRING_DUPLIKAT",
            "STILLINGSIDENDRING_SAMME_ID",
            "STILLINGSIDENDRING_SAMME_NYE_ID",
            "STILLINGSIDENDRING_KJEDE",
            "GRUPPE_UKJENT",
            "GRUPPE_MANGLER",
            "STILLING_UKJENT",
            "KOBLING_TVETYDIG",
            "STILLINGSIDENDRING_UKJENT_STILLING",
            "TIMER_STILLING_UKJENT",
            "INNSENDINGSID_GJENBRUKT",
            "INNSENDING_FOR_STOR",
            "BEHANDLING_FEILET"
          ]
        },
        "melding": {
          "title": "Melding",
          "description": "Forklaring for mennesker. Inneholder aldri fødselsnummer",
          "type": "string",
          "minLength": 1
        },
        "sti": {
          "title": "Sti",
          "description": "JSON Pointer (RFC 6901) til feltet i innsendingen feilen gjelder",
          "type": "string",
          "format": "json-pointer",
          "examples": [
            "/personer/3/tidslinje/perioder/0/fraOgMed"
          ]
        }
      },
      "required": [
        "kode",
        "melding"
      ],
      "additionalProperties": false
    }
  }
}
